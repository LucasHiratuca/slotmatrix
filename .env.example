# Ambiente (em produção use NODE_ENV=production)
NODE_ENV=development
PORT=18081
APP_PUBLIC_URL=http://localhost:18174
CORS_ORIGINS=http://localhost:18174

# Banco de dados e Redis (gere senhas fortes em produção; nunca reutilize exemplos)
MARIADB_ROOT_PASSWORD=<GENERATE_STRONG_DB_ROOT_PASSWORD>
MARIADB_PASSWORD=<GENERATE_STRONG_DB_USER_PASSWORD>
REDIS_PASSWORD=<GENERATE_STRONG_REDIS_PASSWORD>
DATABASE_URL=mysql://slotmatrix:<GENERATE_STRONG_DB_USER_PASSWORD>@localhost:13308/slotmatrix
REDIS_URL=redis://:<GENERATE_STRONG_REDIS_PASSWORD>@localhost:16381

# Segredos criptográficos (OBRIGATÓRIO >= 24 caracteres aleatórios em NODE_ENV=production)
# Ex.: openssl rand -hex 32
JWT_SECRET=<GENERATE_64_CHAR_HEX_JWT_SECRET>
BILLING_WEBHOOK_SECRET=<GENERATE_64_CHAR_HEX_WEBHOOK_SECRET>

# S3 / Garage / MinIO
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=clinic-docs
S3_ACCESS_KEY=<GENERATE_OR_SET_S3_ACCESS_KEY>
S3_SECRET_KEY=<GENERATE_OR_SET_S3_SECRET_KEY>
S3_USE_SSL=false

# Controles de segurança e demo (SEMPRE false em produção)
ALLOW_LOCAL_WEBHOOKS=false
AUTO_SEED=false
ENABLE_BILLING_SIMULATOR=false
ENABLE_API_DOCS=false
VITE_DEMO_MODE=false

# Stripe Subscriptions (use chaves sk_test_ / whsec_ de teste em homologação)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# SMTP / Envio de e-mails (Gmail, Outlook, Resend, Brevo, etc.)
# Para Gmail: ative 2FA na sua conta Google e crie uma "Senha de app" em myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=SlotMatrix <seu-email@gmail.com>
SMTP_SECURE=true
