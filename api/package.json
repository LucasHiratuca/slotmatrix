{
  "name": "slotmatrix-api",
  "version": "1.0.0",
  "private": true,
  "description": "SlotMatrix - Multi-Resource Scheduling, Anti-No-Show & Smart Waitlist SaaS (modular monolith, DDD)",
  "scripts": {
    "build": "tsc --noEmit",
    "start:api": "tsx src/main-api.ts",
    "start:worker": "tsx src/main-worker.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "dev": "tsx watch src/main-api.ts"
  },
  "dependencies": {
    "@types/multer": "^2.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "multer": "^2.5.0",
    "mysql2": "^3.11.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "supertest": "^7.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.5"
  }
}
